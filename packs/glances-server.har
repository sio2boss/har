#!/bin/bash

if [[ $EUID -ne 0 ]]; then
    echo "This script must be run with sudo"
    exit 1
fi

apt-get -y install python3-venv >/dev/null 2>&1
if [ ! -d /opt/glances-venv ]; then
    python3 -m venv /opt/glances-venv
fi
source /opt/glances-venv/bin/activate
pip install glances bottle uvicorn fastapi pynvml >/dev/null 2>&1
cat <<'EOF' > /etc/systemd/system/glances.service
[Unit]
Description=Glances
After=network.target

[Service]
ExecStart=/bin/bash -c 'source /opt/glances-venv/bin/activate && glances -w'
Restart=on-abort
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >/dev/null 2>&1
systemctl enable glances.service >/dev/null 2>&1
systemctl restart glances.service >/dev/null 2>&1

#systemctl status glances.service
echo "http://$(hostname -I | awk '{print $1}'):61208"